APP_NAME=fds-backend
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
DATABASE_URL=postgres://postgres:postgres@db:5432/fds?sslmode=disable
DB_AUTO_MIGRATE=true
DB_MAX_IDLE_CONNS=10
DB_MAX_OPEN_CONNS=50
DB_CONN_MAX_LIFETIME_MINUTES=30
JWT_SECRET=replace-this-with-a-secure-secret
JWT_ACCESS_TTL_HOURS=24
JWT_REFRESH_TTL_HOURS=720
JWT_REFRESH_AUDIENCE=admin-refresh
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
UPLOADS_DIR=./uploads
UPLOAD_PUBLIC_BASE_PATH=/uploads
UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_MIME=image/png,image/jpeg,image/webp
UPLOAD_ALLOWED_EXTS=.png,.jpg,.jpeg,.webp
UPLOAD_PRESETS_SUBDIR=presets
UPLOAD_ORDERS_SUBDIR=design-submissions
UPLOAD_TEMP_SUBDIR=tmp
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
TRUSTED_PROXIES=
ADMIN_SEED_NAME=System Admin
ADMIN_SEED_EMAIL=admin@fds.local
ADMIN_SEED_PASSWORD=12345678
SEED_DEMO_DATA=true
